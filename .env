# 周昱含生日页的公开界面文案。私人照片与素材路径放进 .env.local。
VITE_LANGUAGE=zh
VITE_BIRTHDAY_NAME=周昱含
VITE_BIRTHDAY_GENDER=female
VITE_BIRTHDAY_RELATIONSHIP=celebration
VITE_BIRTHDAY_COLOR="#C68BFF"
VITE_FAVORITE_EMOJIS="🌙,✨,💜,🎂,🌸"
VITE_BIRTHDAY_CUSTOM_MESSAGE="周昱含，生日快乐。愿新的一岁有更多喜欢的事，也有更多时间做自己。"
VITE_BIRTHDAY_LETTER_TITLE="写给周昱含的一封信"
VITE_BIRTHDAY_LETTER_OVERRIDE="周昱含，生日快乐！\n\n希望你今天能睡到自然醒、吃到喜欢的蛋糕，听到几句让你忍不住笑出来的话。\n\n愿你新的一岁，忙的时候有盼头，累的时候能停下来。想做的事可以慢慢做，喜欢的自己也可以慢慢成为。\n\n今天的愿望留给你。祝你生日快乐，往后的平常日子也快乐。"
VITE_SHOW_QUIZ_SECTION=false
VITE_SHOW_HEART_TREE_SECTION=false
VITE_SHOW_VIDEO_SECTION=false
VITE_SHOW_FINAL_SURPRISE=false
VITE_SHOW_GIFT_SECTION=false
VITE_PASSWORD_REQUIRED=false
VITE_SOUND_EFFECTS=false
VITE_BGM_URL=off
